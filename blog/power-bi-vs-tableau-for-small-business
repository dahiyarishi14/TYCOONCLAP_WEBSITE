          <polyline points="28,138 66,112 104,124 142,86 180,98 214,66" fill="none" stroke="#F3B94D" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="214" cy="66" r="7" fill="#E9584C"/>
