          <text x="0" y="205" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="20" fill="#2E3A55">Tableau</text>
        </g>
        <circle cx="350" cy="135" r="34" fill="#E9584C"/>
