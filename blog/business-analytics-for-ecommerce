          <rect x="120" y="76" width="30" height="36" rx="5" fill="#fff"/>
          <rect x="160" y="68" width="30" height="44" rx="5" fill="#F3B94D"/>
        </g>
        <g transform="translate(380,60)">
          <rect width="250" height="190" rx="18" fill="#fff" stroke="#9FB6AE"/>
          <rect x="18" y="18" width="100" height="12" rx="6" fill="#DCEFE9"/>
          <rect x="24" y="130" width="28" height="40" rx="5" fill="#4C9C8B"/>
          <rect x="64" y="104" width="28" height="66" rx="5" fill="#357566"/>
          <rect x="104" y="116" width="28" height="54" rx="5" fill="#4C9C8B"/>
          <rect x="144" y="80" width="28" height="90" rx="5" fill="#357566"/>
          <rect x="184" y="56" width="28" height="114" rx="5" fill="#E9584C"/>
          <rect x="24" y="44" width="62" height="26" rx="13" fill="#FDEED0"/>
          <text x="55" y="62" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="13" fill="#966A0B" text-anchor="middle">ROAS</text>
        </g>
